  // ═══ BUDGET & DIET PREFERENCE HELPERS ═══

  function setBudget(val, btn) {
    const slider  = document.getElementById('budgetSlider');
    const display = document.getElementById('budgetDisplay');
    if (slider)  slider.value     = val;
    if (display) display.innerText = val;
    // Reset all preset button styles
    ['presetBudget','presetMid','presetPremium'].forEach(id => {
      const el = document.getElementById(id);
      if (el) { el.style.borderColor = 'var(--mist)'; el.style.background = '#F8FAFC'; el.style.color = 'var(--slate)'; }
    });
    // Highlight clicked preset
    if (btn) { btn.style.borderColor = 'var(--rose)'; btn.style.background = '#FFF1F2'; btn.style.color = 'var(--rose)'; }
    updatePlanPrefSummary();
  }

  function toggleDietChip(el) {
    el.classList.toggle('selected');
    updatePlanPrefSummary();
  }

  function quickAddCantEat(item) {
    const ta = document.getElementById('cantEatInput');
    if (!ta) return;
    const current = ta.value.trim();
    ta.value = current ? current.replace(/,\s*$/, '') + ', ' + item : item;
    updateCantEatCount();
    updatePlanPrefSummary();
  }

  function updateCantEatCount() {
    const ta = document.getElementById('cantEatInput');
    const countEl = document.getElementById('cantEatCount');
    if (!ta || !countEl) return;
    const items = ta.value.split(',').map(s => s.trim()).filter(Boolean);
    if (items.length > 0) {
      countEl.style.display = 'inline-block';
      countEl.innerText = items.length + (items.length === 1 ? ' item' : ' items');
    } else {
      countEl.style.display = 'none';
    }
    updatePlanPrefSummary();
  }

  function getSelectedDietChips() {
    return Array.from(document.querySelectorAll('.diet-chip.selected'))
                .map(el => el.getAttribute('data-value'));
  }

  function getPlanPreferences() {
    const budget       = document.getElementById('budgetSlider')?.value || '150';
    const restrictions = getSelectedDietChips();
    const cantEat      = (document.getElementById('cantEatInput')?.value || '').trim();
    return { budget, restrictions, cantEat };
  }

  function updatePlanPrefSummary() {
    const summaryDiv = document.getElementById('planPrefSummary');
    const textEl     = document.getElementById('planPrefText');
    if (!summaryDiv || !textEl) return;

    const prefs = getPlanPreferences();
    const parts = [];
    parts.push(`stay within RM ${prefs.budget}/week budget`);
    if (prefs.restrictions.length) parts.push(`follow ${prefs.restrictions.join(', ')} guidelines`);
    if (prefs.cantEat) parts.push(`avoid ${prefs.cantEat}`);

    if (parts.length > 1 || prefs.restrictions.length || prefs.cantEat) {
      summaryDiv.style.display = 'block';
      textEl.innerText = parts.join(' · ');
    } else {
      summaryDiv.style.display = 'none';
    }
  }

  // ═══ MAP & ETA LOGIC ═══
let currentTransport = 'drive';
let currentEtaMinutes = 12;

// Appointment is at 10:00 AM — calculate leave by & arrive by
function updateMapTimes(etaMinutes) {
  currentEtaMinutes = etaMinutes;
  const apptHour = 10, apptMin = 0;

  // Arrive 10 min before appointment
  const arriveMin = apptHour * 60 + apptMin - 10;
  const leaveMin  = arriveMin - etaMinutes;

  const fmt = totalMin => {
    const h = Math.floor(Math.abs(totalMin) / 60) % 12 || 12;
    const m = String(Math.abs(totalMin) % 60).padStart(2, '0');
    const ap = totalMin >= 720 ? 'PM' : 'AM';
    return `${h}:${m} ${ap}`;
  };

  const leaveEl   = document.getElementById('leaveByTime');
  const arriveEl  = document.getElementById('arriveByTime');
  const etaEl     = document.getElementById('etaTime');
  const etaBadge  = document.getElementById('etaBadge');

  if (leaveEl)  leaveEl.innerText  = fmt(leaveMin);
  if (arriveEl) arriveEl.innerText = fmt(arriveMin);
  if (etaEl)    etaEl.innerText    = `${etaMinutes} min`;
  if (etaBadge) etaBadge.innerText = `⏱ ${etaMinutes} min away`;
}

function selectTransport(mode, etaMins, distance, trafficText, trafficPct) {
  currentTransport = mode;

  // Reset all buttons
  ['drive','grab','lrt','walk'].forEach(m => {
    const btn = document.getElementById('mode-' + m);
    if (!btn) return;
    btn.style.borderColor = 'var(--mist)';
    btn.style.background  = '#F8FAFC';
    btn.style.color       = 'var(--slate)';
  });

  // Activate selected
  const activeBtn = document.getElementById('mode-' + mode);
  if (activeBtn) {
    activeBtn.style.borderColor = 'var(--teal)';
    activeBtn.style.background  = 'rgba(13,148,136,.08)';
    activeBtn.style.color       = 'var(--teal)';
  }

  // Update distance label
  const distEl = document.getElementById('etaDistance');
  if (distEl) distEl.innerText = distance;

  // Update traffic bar
  const bar   = document.getElementById('trafficBar');
  const label = document.getElementById('trafficLabel');
  const trafficColors = {
    'Clear':    { w:'5%',  bg:'linear-gradient(90deg,#22C55E,#86EFAC)', badge:'#D1FAE5', text:'#065F46' },
    'Light':    { w:'20%', bg:'linear-gradient(90deg,#22C55E,#86EFAC)', badge:'#D1FAE5', text:'#065F46' },
    'Moderate': { w:'55%', bg:'linear-gradient(90deg,#F59E0B,#FCD34D)', badge:'#FEF3C7', text:'#92400E' },
    'Heavy':    { w:'85%', bg:'linear-gradient(90deg,#EF4444,#FCA5A5)', badge:'#FEE2E2', text:'#991B1B' }
  };
  const tc = trafficColors[trafficText] || trafficColors['Light'];
  if (bar)   { bar.style.width = tc.w; bar.style.background = tc.bg; }
  if (label) { label.innerText = trafficText; label.style.background = tc.badge; label.style.color = tc.text; }

  updateMapTimes(etaMins);
}

