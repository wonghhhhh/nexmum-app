    const minRating = parseFloat(document.getElementById('selRating')?.value || '0');

    // Update chips
    if (['all','clinic','home','tele'].includes(type)) {
      document.querySelectorAll('[id^="chip-"]').forEach(c => { c.classList.remove('chip-active'); c.classList.add('chip-default'); });
      const chip = document.getElementById('chip-' + type);
      if (chip) { chip.classList.add('chip-active'); chip.classList.remove('chip-default'); }
    }

    const activeChip = document.querySelector('[id^="chip-"].chip-active');
    const visitFilter = activeChip ? activeChip.id.replace('chip-', '') : 'all';

    document.querySelectorAll('.doc-card').forEach(card => {
      const cardType = card.getAttribute('data-type');
      const cardSpec = card.getAttribute('data-spec') || '';
      const cardRating = parseFloat(card.getAttribute('data-rating') || '0');
      const cardText = card.innerText.toLowerCase();

      const matchVisit = visitFilter === 'all' || cardType === visitFilter;
      const matchSpec = !spec || cardSpec.includes(spec);
      const matchRating = !minRating || cardRating >= minRating;
      const matchSearch = !search || cardText.includes(search);

      card.style.display = (matchVisit && matchSpec && matchRating && matchSearch) ? '' : 'none';
    });
  }

