function mapZoom(dir) {
  // Visual feedback only (no real zoom on SVG map)
  const canvas = document.getElementById('mapCanvas');
  if (!canvas) return;
  canvas.style.transition = 'transform .25s ease';
  const current = parseFloat(canvas.dataset.scale || '1');
  const next = Math.min(1.4, Math.max(0.85, current + dir * 0.1));
  canvas.dataset.scale = next;
  canvas.style.transform = `scale(${next})`;
  canvas.style.transformOrigin = 'center center';
}

// Init map on page load
setTimeout(() => selectTransport('drive', 12, '4.2 km', 'Light', '20%'), 300);
  // ═══ LOGIN ═══
