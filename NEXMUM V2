    : '';

  let html = `<div style="font-family:sans-serif">${budgetBanner}`;

  days.forEach((d, i) => {
    html += `
    <div class="card" style="background:${dayColors[i%7]};border-color:${dayBorders[i%7]};margin-bottom:10px;padding:12px">
      <div style="font-size:12px;font-weight:bold;color:var(--ink);margin-bottom:8px;display:flex;justify-content:space-between;align-items:center">
        <span>📅 ${d.day}</span>
