          <span style="font-size:10px;background:rgba(0,0,0,.06);border-radius:6px;padding:2px 7px;font-weight:600">~${d.kcal} kcal</span>
          ${d.est_daily_cost ? `<span style="font-size:10px;background:#D1FAE5;color:#065F46;border-radius:6px;padding:2px 7px;font-weight:600">${d.est_daily_cost}</span>` : ''}
        </div>
      </div>
