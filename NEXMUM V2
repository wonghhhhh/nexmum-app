  async function analyzeMealWithAI() {
    const type = document.getElementById('mealType').value;
    const desc = document.getElementById('mealDesc').value.trim();
    const qty  = document.getElementById('mealQty').value.trim();
    const time = document.getElementById('mealTime').value;
