        </div>
        ${plan.cost_saving_tip ? `<div style="margin-top:8px;font-size:10px;color:#166534;border-top:1px solid #BBF7D0;padding-top:6px">💡 <strong>Budget tip:</strong> ${plan.cost_saving_tip}</div>` : ''}
