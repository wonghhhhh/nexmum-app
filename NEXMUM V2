  function recordKick() {
    if (!kickData.startTime) {
      kickData.startTime = Date.now();
      kickSessionActive = true;
      // start live timer
      if (kickTimerInterval) clearInterval(kickTimerInterval);
      kickTimerInterval = setInterval(updateKickTimer, 1000);
    }
    kickData.count++;
    document.querySelectorAll('#kickCount').forEach(el => el.innerText = kickData.count);
    updateKickProgressRing();
    const status = document.getElementById('kickStatus');
    if (status) {
      if (kickData.count >= 10) {
        status.innerHTML = `<span style="color:#4ADE80;font-weight:bold">✅ Target reached! Great job, baby is active.</span>`;
      } else {
        status.innerText = `${10 - kickData.count} more kick${10 - kickData.count !== 1 ? 's' : ''} to reach today's target`;
      }
    }
    // Pulse animation on big button
    const btn = document.getElementById('kickBigBtn');
    if (btn) { btn.style.transform = 'translate(-50%,-50%) scale(0.92)'; setTimeout(() => btn.style.transform = 'translate(-50%,-50%) scale(1)', 180); }
  }

  function updateKickTimer() {
    if (!kickData.startTime) return;
    const elapsed = Math.floor((Date.now() - kickData.startTime) / 1000);
    const m = String(Math.floor(elapsed / 60)).padStart(2, '0');
    const s = String(elapsed % 60).padStart(2, '0');
    const el = document.getElementById('kickTimerDisplay');
    if (el) el.innerText = `${m}:${s}`;
  }

  function updateKickProgressRing() {
    const ring = document.getElementById('kickProgressRing');
    if (!ring) return;
    const pct = Math.min(kickData.count / 10, 1);
    const circumference = 553;
    ring.style.strokeDashoffset = circumference * (1 - pct);
  }

