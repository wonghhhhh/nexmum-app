<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=390, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>NexMum Maternal App</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:Georgia,'Times New Roman',serif;background:#FFF8F9;max-width:390px;margin:0 auto;min-height:100vh;position:relative;overflow-x:hidden}
  :root{
    --rose:#E8547A;--rose-soft:#FF8FAB;--peach:#FFB8C6;--blush:#FFE4EC;--cream:#FFF8F9;
    --teal:#0D9488;--teal-soft:#5EEAD4;--amber:#F59E0B;--jade:#22C55E;--sky:#38BDF8;
    --ink:#1E1523;--slate:#64748B;--mist:#F1F5F9;--white:#FFFFFF;--blue:#3B82F6;
  }
  .screen{display:none;padding-bottom:90px;animation:fadeUp .3s ease}
  .screen.active{display:block}
  @keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

  .hdr{padding:52px 20px 24px;position:relative;overflow:hidden;border-bottom-left-radius:20px;border-bottom-right-radius:20px;margin-bottom:12px}
  .hdr-rose{background:linear-gradient(160deg,var(--rose) 0%,var(--rose-soft) 55%,var(--peach) 100%)}
  .hdr-teal{background:linear-gradient(160deg,var(--teal),var(--teal-soft))}
  .hdr-jade{background:linear-gradient(160deg,#16A34A,#4ADE80)}
  .hdr-amber{background:linear-gradient(160deg,var(--amber),#FCD34D)}
  .hdr-blue{background:linear-gradient(160deg,#3B82F6,#93C5FD)}

  .hdr-label{font-size:10px;color:rgba(255,255,255,.8);font-family:sans-serif;letter-spacing:2px;text-transform:uppercase}
  .hdr-title{font-size:20px;font-weight:bold;color:#fff;margin-top:4px}
  .hdr-sub{font-size:12px;color:rgba(255,255,255,.85);font-family:sans-serif;margin-top:2px}
  .pad{padding:0 16px}
  .card{background:#fff;border-radius:20px;padding:16px;box-shadow:0 2px 16px rgba(232,84,122,.08);border:1px solid var(--blush);margin-bottom:12px}

  .sec-hdr{display:flex;justify-content:space-between;align-items:center;margin:16px 0 10px}
  .sec-hdr h3{font-size:15px;font-weight:bold;color:var(--ink)}
  .sec-hdr span{font-size:12px;color:var(--rose);font-family:sans-serif;font-weight:600;cursor:pointer}
  .badge{font-size:9px;font-family:sans-serif;font-weight:700;letter-spacing:.8px;border-radius:6px;padding:2px 7px;display:inline-block;text-transform:uppercase}

  .btn-rose{background:linear-gradient(135deg,var(--rose),var(--rose-soft));border:none;border-radius:10px;padding:8px 16px;font-size:12px;color:#fff;font-family:sans-serif;font-weight:700;cursor:pointer;width:100%;text-align:center}
  .btn-teal{background:var(--teal);border:none;border-radius:10px;padding:8px 16px;font-size:12px;color:#fff;font-family:sans-serif;font-weight:700;cursor:pointer;width:100%;text-align:center}
  .btn-outline{background:transparent;border:1px solid var(--rose);color:var(--rose);border-radius:10px;padding:8px 16px;font-size:12px;font-family:sans-serif;font-weight:700;cursor:pointer;width:100%;text-align:center}

  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}

  /* Bottom Nav */
  .bnav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:390px;max-width:100%;background:rgba(255,255,255,.97);backdrop-filter:blur(24px);border-top:1px solid var(--blush);display:flex;justify-content:space-around;padding:10px 0 18px;z-index:200}
  .bnav button{display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:none;cursor:pointer;padding:4px 10px;border-radius:12px}
  .bnav button .nav-icon{font-size:22px;transition:all .2s;display:block;line-height:1}
  .bnav button .nav-label{font-size:9px;font-family:sans-serif;letter-spacing:.3px;color:var(--slate);font-weight:400;transition:color .2s}
  .bnav button.active .nav-icon{transform:scale(1.18);color:var(--rose)}
  .bnav button.active .nav-label{color:var(--rose);font-weight:700}

  /* Modals */
  .modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:2000;display:none;align-items:center;justify-content:center;opacity:0;transition:opacity 0.3s}
  .modal-overlay.show{display:flex;opacity:1}
  .modal{background:var(--white);width:90%;max-width:350px;border-radius:20px;padding:20px;transform:translateY(20px);transition:transform 0.3s;max-height:85vh;overflow-y:auto}
  .modal-overlay.show .modal{transform:translateY(0)}
  .input-field{width:100%;padding:12px;border:1px solid var(--slate);border-radius:10px;margin-top:8px;font-size:14px;font-family:sans-serif;outline:none}

  /* Chatbot */
  .chat-msg{max-width:85%;padding:10px 14px;border-radius:12px;font-size:13px;font-family:sans-serif;line-height:1.4;margin-bottom:8px}
  .chat-ai{background:rgba(13,148,136,.1);border:1px solid rgba(13,148,136,.3);align-self:flex-start;border-bottom-left-radius:2px;color:var(--teal)}
  .chat-user{background:var(--teal);color:white;align-self:flex-end;border-bottom-right-radius:2px;margin-left:auto}

  .filter-btn{background:rgba(255,255,255,0.8);border:1px solid var(--slate);border-radius:12px;padding:6px 12px;font-size:11px;font-family:sans-serif;font-weight:700;cursor:pointer;color:var(--slate);margin-right:4px}
  .filter-btn.active{background:var(--rose);color:white;border-color:var(--rose)}

  /* Login Screen — full-page overlay, not part of module screens */
  #loginPage{position:fixed;top:0;left:0;width:100%;height:100%;z-index:9999;display:flex;flex-direction:column;background:linear-gradient(160deg,var(--rose) 0%,var(--rose-soft) 55%,var(--peach) 100%);max-width:390px;left:50%;transform:translateX(-50%)}
  #loginPage.hidden{display:none}
  .login-logo{text-align:center;padding:60px 20px 30px}
  .login-card{background:white;border-radius:28px 28px 0 0;flex:1;padding:30px 24px;overflow-y:auto}

  /* Track Modal */
  .track-step{display:flex;gap:12px;margin-bottom:16px;align-items:flex-start}
  .track-dot{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;margin-top:2px}
  .track-line{width:2px;background:var(--blush);height:100%;position:absolute;left:15px;top:34px}
  .track-step-wrap{position:relative}

  /* Vital range badge */
  .vital-range{font-size:9px;font-family:sans-serif;font-weight:600;padding:2px 6px;border-radius:5px;margin-top:3px;display:inline-block}
  .range-normal{background:#D1FAE5;color:#065F46}
  .range-low{background:#FEF3C7;color:#92400E}
  .range-high{background:#FEE2E2;color:#991B1B}

  /* AI Maternity Assistant */
  .ai-suggestion{background:var(--blush);border-radius:10px;padding:8px 10px;font-size:11px;font-family:sans-serif;color:var(--rose);cursor:pointer;border:1px solid var(--peach);flex-shrink:0}

  /* Profile pic upload */
  .prof-pic-wrap{position:relative;width:60px;height:60px;cursor:pointer}
  .prof-pic-wrap .edit-overlay{position:absolute;bottom:0;right:0;width:18px;height:18px;background:var(--rose);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;color:white}

  /* Utilities */
  .hide{display:none!important}

  /* Family Sync */
  .family-member{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--mist)}
  .family-avatar{width:36px;height:36px;border-radius:50%;background:var(--blush);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:bold;color:var(--rose);flex-shrink:0}

  /* ── GrabDoc Tiles ── */
  .gdoc-tile{background:#fff;border-radius:18px;padding:16px 10px;box-shadow:0 2px 12px rgba(0,0,0,.07);border:1px solid var(--mist);text-align:center;cursor:pointer;transition:transform .15s,box-shadow .15s;display:flex;flex-direction:column;align-items:center;gap:6px}
  .gdoc-tile:active{transform:scale(.96)}
  .gdoc-tile .tile-icon{font-size:30px;line-height:1}
  .gdoc-tile .tile-label{font-size:12px;font-weight:700;color:var(--ink);font-family:sans-serif;line-height:1.2}
  .gdoc-tile .tile-sub{font-size:9px;color:var(--slate);font-family:sans-serif}

  /* ── Filter Panel ── */
  .filter-panel{background:#fff;border-radius:14px;padding:12px;margin-bottom:12px;border:1px solid var(--mist);box-shadow:0 2px 8px rgba(0,0,0,.05)}
  .filter-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
  .chip{border-radius:20px;padding:5px 12px;font-size:11px;font-family:sans-serif;font-weight:600;cursor:pointer;border:1.5px solid transparent;transition:all .2s;white-space:nowrap}
  .chip-active{background:var(--rose);color:#fff;border-color:var(--rose)}
  .chip-default{background:#F8FAFC;color:var(--slate);border-color:var(--mist)}
  select.filter-sel{background:#F8FAFC;border:1.5px solid var(--mist);border-radius:20px;padding:5px 10px;font-size:11px;font-family:sans-serif;color:var(--ink);cursor:pointer;outline:none;flex:1}

  /* ── Doctor Card ── */
  .doc-availability{display:inline-flex;align-items:center;gap:4px;font-size:9px;font-family:sans-serif;font-weight:600;padding:2px 7px;border-radius:5px;margin-top:4px}

  /* ── Meals Tabs ── */
  .meal-tabs{display:flex;background:#fff;border-radius:16px;padding:4px;box-shadow:0 1px 8px rgba(0,0,0,.07);margin:0 16px 14px;border:1px solid var(--mist)}
  .meal-tab{flex:1;padding:8px 4px;text-align:center;font-size:11px;font-family:sans-serif;font-weight:600;color:var(--slate);border-radius:12px;cursor:pointer;transition:all .2s}
  .meal-tab.active{background:linear-gradient(135deg,#16A34A,#4ADE80);color:#fff}

  /* Meal food item */
  .food-item{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #F8FAFC}
  .food-item:last-child{border-bottom:none}
  .food-emoji{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}

  /* Meal section group */
  .meal-section{background:#fff;border-radius:16px;padding:12px 14px;box-shadow:0 1px 8px rgba(0,0,0,.06);border:1px solid #F0F9F0;margin-bottom:10px}
  .meal-section-hdr{display:flex;align-items:center;gap:8px;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid #F0F9F0}

  /* Booking time slot */
  .time-slot{background:#F8FAFC;border:1.5px solid var(--mist);border-radius:10px;padding:8px;font-size:12px;font-family:sans-serif;text-align:center;cursor:pointer;transition:all .2s;color:var(--slate)}
  .time-slot.selected,.time-slot:hover{background:var(--rose);color:#fff;border-color:var(--rose)}
  .time-slot.unavailable{opacity:.4;cursor:not-allowed;pointer-events:none}

  /* Profile emoji icon */
  .prof-icon{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}

  /* AI meal loading bar */
  @keyframes loadBar{0%{width:0%;margin-left:0}50%{width:70%;margin-left:15%}100%{width:0%;margin-left:100%}}

  /* ── Diet Chip Styles ── */
  .diet-chip {
    border-radius: 20px;
    padding: 5px 11px;
    font-size: 11px;
    font-family: sans-serif;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid var(--mist);
    background: #F8FAFC;
    color: var(--slate);
    transition: all 0.18s;
    user-select: none;
    white-space: nowrap;
  }
  .diet-chip.selected {
    background: var(--rose);
    color: white;
    border-color: var(--rose);
  }

  /* Budget slider thumb */
  #budgetSlider {
    -webkit-appearance: none;
    height: 4px;
    background: linear-gradient(90deg, var(--rose) 0%, var(--peach) 100%);
    border-radius: 4px;
    outline: none;
  }
  #budgetSlider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--rose);
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(232,84,122,.4);
  }

  /* Budget preset button active state */
  .budget-preset-active {
    border-color: var(--rose) !important;
    background: #FFF1F2 !important;
    color: var(--rose) !important;
  }
</style>
</head>
<body>

<!-- ═══════════════════════════ LOGIN PAGE (standalone overlay) ═══════════════════════════ -->
<div id="loginPage">
  <div class="login-logo">
    <img src="data:image/png;base64," alt="NexMum" style="width:90px;height:90px;border-radius:22px;margin-bottom:8px;box-shadow:0 4px 20px rgba(233,97,130,.25)">
    <div style="font-size:26px;font-weight:bold;color:white;font-family:sans-serif">NexMum</div>
    <div style="font-size:13px;color:rgba(255,255,255,.85);font-family:sans-serif;margin-top:4px">Maternal Health Companion</div>
  </div>
  <div class="login-card">
    <div style="font-size:22px;font-weight:bold;color:var(--ink);margin-bottom:4px;font-family:sans-serif">Welcome Back 🌸</div>
    <div style="font-size:13px;color:var(--slate);font-family:sans-serif;margin-bottom:24px">Sign in to your account</div>

    <label style="font-size:11px;font-weight:700;color:var(--slate);font-family:sans-serif;text-transform:uppercase;letter-spacing:.8px">Email</label>
    <input type="email" id="loginEmail" class="input-field" placeholder="sarah@example.com" value="sarah@example.com" style="margin-bottom:16px">

    <label style="font-size:11px;font-weight:700;color:var(--slate);font-family:sans-serif;text-transform:uppercase;letter-spacing:.8px">Password</label>
    <div style="position:relative">
      <input type="password" id="loginPass" class="input-field" placeholder="••••••••" value="password123">
      <span onclick="togglePwd()" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);cursor:pointer;font-size:16px;color:var(--slate)">👁</span>
    </div>

    <div style="text-align:right;margin:8px 0 20px">
      <span style="font-size:12px;color:var(--rose);font-family:sans-serif;cursor:pointer;font-weight:600">Forgot Password?</span>
    </div>

    <!-- API Key Setup -->
    <div id="apiKeySetup" style="margin-bottom:20px">
      <label style="font-size:11px;font-weight:700;color:var(--slate);font-family:sans-serif;text-transform:uppercase;letter-spacing:.8px">
        🔑 Anthropic API Key <span style="color:var(--rose)">*</span>
      </label>
      <div style="position:relative">
        <input type="password" id="apiKeyInput" class="input-field"
          placeholder="sk-ant-api03-..."
          style="padding-right:44px;font-family:monospace;font-size:12px"
          oninput="validateApiKeyInput()" onkeydown="if(event.key==='Enter')doLogin()">
        <span onclick="toggleApiKeyVisibility()" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);cursor:pointer;font-size:15px;color:var(--slate)">👁</span>
      </div>
      <div style="display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap">
        <label style="display:flex;align-items:center;gap:5px;font-size:11px;font-family:sans-serif;color:var(--slate);cursor:pointer">
          <input type="checkbox" id="rememberKey" style="accent-color:var(--rose)"> Remember key this session
        </label>
        <button id="testKeyBtn" onclick="testApiKey()" style="margin-left:auto;background:#F8FAFC;border:1px solid var(--mist);border-radius:8px;padding:5px 12px;font-size:11px;font-family:sans-serif;font-weight:700;color:var(--slate);cursor:pointer">🔍 Test Key</button>
      </div>
      <div id="apiKeyHint" style="font-size:10px;color:var(--slate);font-family:sans-serif;margin-top:5px;line-height:1.5">
        Required for all AI features. Get yours free at
        <a href="https://console.anthropic.com/keys" target="_blank" style="color:var(--rose);font-weight:600">console.anthropic.com</a>.
      </div>
      <div id="apiKeyError" style="font-size:10px;color:#EF4444;font-family:sans-serif;margin-top:4px;display:none"></div>
      <div id="apiKeySuccess" style="font-size:10px;color:#15803D;font-family:sans-serif;margin-top:4px;display:none">✅ API key verified and ready!</div>
    </div>

    <button class="btn-rose" id="loginBtn" onclick="doLogin()" style="font-size:15px;padding:14px">Sign In</button>

    <div style="text-align:center;margin-top:16px;font-size:12px;font-family:sans-serif;color:var(--slate)">
      Don't have an account? <span style="color:var(--rose);font-weight:700;cursor:pointer" onclick="alert('Registration coming soon!')">Sign Up</span>
    </div>

    <div style="display:flex;align-items:center;margin:16px 0">
      <div style="flex:1;height:1px;background:var(--mist)"></div>
      <div style="font-size:11px;color:var(--slate);font-family:sans-serif;padding:0 12px">or continue with</div>
      <div style="flex:1;height:1px;background:var(--mist)"></div>
    </div>

    <button onclick="doLogin()" style="width:100%;background:white;border:1px solid var(--mist);border-radius:10px;padding:12px;font-size:13px;font-family:sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;color:var(--ink)">
      <span style="font-size:18px">🔵</span> Continue with Google
    </button>
  </div>
</div>

<!-- ═══════════════════════════ HOME SCREEN ═══════════════════════════ -->
<div id="s-home" class="screen active">
  <div class="hdr hdr-rose">
    <div style="position:absolute;top:-60px;right:-40px;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,.1)"></div>
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px">
      <div>
        <div style="font-size:22px;font-weight:bold;color:#fff;margin-top:3px;line-height:1.2" id="greetName" data-tr="greet">Good Morning, Sarah 🌸</div>
      </div>
      <div id="headerAvatar" onclick="nav('profile')" style="width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:bold;color:#fff;border:2px solid rgba(255,255,255,.5);cursor:pointer">SL</div>
    </div>

    <div style="background:rgba(255,255,255,.22);backdrop-filter:blur(12px);border-radius:20px;padding:16px 18px;border:1px solid rgba(255,255,255,.35)">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
        <div>
          <div style="font-size:10px;color:rgba(255,255,255,.8);font-family:sans-serif;letter-spacing:1.5px;text-transform:uppercase" data-tr="tri">Second Trimester</div>
          <div style="font-size:30px;font-weight:bold;color:#fff;line-height:1" data-tr="week">Week 24</div>
        </div>
        <div style="text-align:center">
          <div style="font-size:32px">🌽</div>
          <div style="font-size:9px;color:rgba(255,255,255,.9);font-family:sans-serif">Baby Size</div>
        </div>
      </div>
    </div>
  </div>

  <div class="pad">
    <div class="sec-hdr">
      <h3 data-tr="vitals">📊 Today's Vitals</h3>
      <div style="display:flex;gap:8px;align-items:center">
        <span onclick="openModal('modal-logvitals')" style="font-size:12px;color:var(--teal);font-family:sans-serif;font-weight:600;cursor:pointer">+ Log</span>
        <span id="syncBtn" onclick="syncWearable()">Sync <i class="ti ti-refresh"></i></span>
      </div>
    </div>
    <div class="grid2" id="vitalsGrid">
    <div class="card" style="padding:12px" id="card-bp">
      <div style="display:flex;align-items:center;gap:8px">
        <div style="font-size:22px">🩺</div>
        <div>
          <div style="font-size:16px;font-weight:bold;color:var(--ink);line-height:1" id="disp-bp">118/76</div>
          <div style="font-size:10px;color:var(--slate);font-family:sans-serif">Blood Pressure</div>
          <span class="vital-range range-normal" id="disp-bp-range">Normal (90-140/60-90)</span>
        </div>
      </div>
    </div>
    <div class="card" style="padding:12px" id="card-hr">
      <div style="display:flex;align-items:center;gap:8px">
        <div style="font-size:22px">❤️</div>
        <div>
          <div style="font-size:16px;font-weight:bold;color:var(--ink);line-height:1" id="disp-hr">82<span style="font-size:10px"> bpm</span></div>
          <div style="font-size:10px;color:var(--slate);font-family:sans-serif">Heart Rate</div>
          <span class="vital-range range-normal" id="disp-hr-range">Normal (60–100 bpm)</span>
        </div>
      </div>
    </div>
    <div class="card" style="padding:12px" id="card-wt">
      <div style="display:flex;align-items:center;gap:8px">
        <div style="font-size:22px">⚖️</div>
        <div>
          <div style="font-size:16px;font-weight:bold;color:var(--ink);line-height:1" id="disp-wt">62.4<span style="font-size:10px"> kg</span></div>
          <div style="font-size:10px;color:var(--slate);font-family:sans-serif">Weight</div>
          <span class="vital-range range-normal" id="disp-wt-range">On Track (58–68 kg)</span>
        </div>
      </div>
    </div>
    <div class="card" style="padding:12px" id="card-kicks">
      <div style="display:flex;align-items:center;gap:8px">
        <div style="font-size:22px">🦶</div>
        <div>
          <div style="font-size:16px;font-weight:bold;color:var(--ink);line-height:1" id="disp-kicks">12<span style="font-size:10px"> kicks</span></div>
