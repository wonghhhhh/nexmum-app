/* ── Highlight FULL-PAGE helpers ── */
function openHiPage(id) {
  var el = document.getElementById('hi-page-' + id);
  if (el) {
    el.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
}
function closeHiPage(id) {
  var el = document.getElementById('hi-page-' + id);
  if (el) {
    el.style.animation = 'slideOutRight .25s cubic-bezier(.55,0,.1,1) forwards';
    setTimeout(function(){
      el.classList.remove('active');
      el.style.animation = '';
      document.body.style.overflow = '';
    }, 250);
  }
}
</script>

<style>
@keyframes slideOutRight{from{opacity:1;transform:translateX(-50%)}to{opacity:0;transform:translateX(calc(-50% + 30px))}}
</style>

<script>
/* ── Highlight detail sheet helpers ── */
function openHiDetail(id) {
  var el = document.getElementById('hi-detail-' + id);
  if (el) { el.style.display = 'flex'; requestAnimationFrame(function(){ el.classList.add('show'); }); }
}
function closeHiDetail(id) {
  var el = document.getElementById('hi-detail-' + id);
  if (el) { el.classList.remove('show'); setTimeout(function(){ el.style.display = 'none'; }, 300); }
}

/* ── Feeling logger ── */
var _selMood = '', _selEnergy = '';
function selectMood(btn, val) {
  _selMood = val;
  document.querySelectorAll('#moodBtns button').forEach(function(b){ b.style.border = '1.5px solid #E2E8F0'; b.style.fontWeight = 'normal'; });
  btn.style.border = '2px solid var(--rose)'; btn.style.fontWeight = '700';
}
function selectEnergy(btn, val) {
  _selEnergy = val;
  document.querySelectorAll('#energyBtns button').forEach(function(b){ b.style.border = '1.5px solid #E2E8F0'; b.style.fontWeight = 'normal'; });
  btn.style.border = '2px solid var(--rose)'; btn.style.fontWeight = '700';
}
function saveFeelingLog() {
  if (!_selMood && !_selEnergy) return;
  var label = (_selMood || '–') + ' · ' + (_selEnergy || '–');
  document.getElementById('feelingLabel').innerText = label;
  document.getElementById('feelingSaved').style.display = 'block';
  setTimeout(function(){ closeHiDetail('feeling'); }, 1200);
}
</script>

