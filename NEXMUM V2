  function updatePreview(){
    const sys = document.getElementById('vitalSystolic').value;
    const dia = document.getElementById('vitalDiastolic').value;
    const hr  = document.getElementById('vitalHR').value;
    const wt  = document.getElementById('vitalWeight').value;
    const kk  = document.getElementById('vitalKicks').value;
    const lines = [];
    if (sys && dia) lines.push(`🩺 BP: ${sys}/${dia} mmHg`);
    if (hr) lines.push(`❤️ HR: ${hr} bpm`);
    if (wt) lines.push(`⚖️ Weight: ${wt} kg`);
    if (kk) lines.push(`🦶 Kicks: ${kk} today`);
    const prev = document.getElementById('vitalPreview');
    if (lines.length > 0){
      prev.style.display = 'block';
      document.getElementById('vitalPreviewText').innerHTML = lines.join('<br>');
    } else {
      prev.style.display = 'none';
    }
  }

