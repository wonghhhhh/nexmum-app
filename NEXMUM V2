        <div><span style="font-size:13px">☀️</span> <strong>${lang==='bm'?'Sarapan':'Breakfast'}:</strong> ${d.breakfast}</div>
        <div><span style="font-size:13px">🌤</span> <strong>${lang==='bm'?'Makan Tengah Hari':'Lunch'}:</strong> ${d.lunch}</div>
        <div><span style="font-size:13px">🌙</span> <strong>${lang==='bm'?'Makan Malam':'Dinner'}:</strong> ${d.dinner}</div>
        <div><span style="font-size:13px">🍎</span> <strong>${lang==='bm'?'Snek':'Snacks'}:</strong> ${d.snacks}</div>
