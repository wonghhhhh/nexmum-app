  function changeLang() {
    const l = document.getElementById('langSel').value;
    const d = langDict[l];
    // Update plain-text elements
    document.querySelectorAll('[data-tr]').forEach(el => {
      const k = el.getAttribute('data-tr');
      if (k === 'greet') {
        const nm = document.getElementById('profName').innerText.split(' ')[0];
        el.innerText = `${d[k]}, ${nm} 🌸`;
      } else if (d[k]) {
        el.innerText = d[k];
      }
    });
    // Update HTML-rich elements (data-tr-html)
    document.querySelectorAll('[data-tr-html]').forEach(el => {
      const k = el.getAttribute('data-tr-html');
      if (d[k]) el.innerHTML = d[k];
    });
    // Update meal date in the correct locale
    const mealDateEl = document.getElementById('mealDate');
    if (mealDateEl) {
      const locale = l === 'bm' ? 'ms-MY' : 'en-GB';
      mealDateEl.innerText = new Date().toLocaleDateString(locale, { weekday:'long', day:'2-digit', month:'long', year:'numeric' });
    }
